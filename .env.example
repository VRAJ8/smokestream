# Copy this file to .env and fill in your own values. Never commit .env.

# PurpleAir READ key from develop.purpleair.com
PURPLEAIR_READ_KEY=

# Live recorder settings
SAMPLE_SIZE=200
SAMPLE_SEED=226
POLL_SECONDS=300
# minimal = last_seen only (delay profile, cheapest); full = also PM and humidity
FIELD_PROFILE=minimal

# Northern California bounding box (Bay Area, Sacramento Valley, Sierra foothills)
BBOX_NW_LAT=41.0
BBOX_NW_LNG=-124.0
BBOX_SE_LAT=36.5
BBOX_SE_LNG=-119.5

# MongoDB Atlas connection string (Connect > Drivers > Python), with your password filled in
MONGODB_URI=
MONGODB_DB=smokestream

# Snowflake (warehouse/README.md). Key-pair sign-in; the private key stays in .secrets/.
# Account identifier looks like ABCDEFG-XY12345 (Snowsight: your name, bottom left > Account > View account details).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/snowflake_key.p8
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
